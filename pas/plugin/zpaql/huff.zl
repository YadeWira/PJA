"""The JPEG again (pjajpeg.Recompose: Huffman and arithmetic scans, sequential and progressive), and main."""

# ---------------------------------------------------------------- the JPEG again

PRED = array(4)
bacc = 0
bn = 0
outn = 0

def putbyte(v):
    global outn
    if PJAX:
        sink(v)
    else:
        out(v)
    outn += 1

def putbits(v, n):
    """n <= 16 bits, the oldest first; FF is followed by 00"""
    global bacc, bn
    bacc = (bacc << n) | (v & ((1 << n) - 1))
    bn += n
    while bn >= 8:
        bn -= 8
        b = (bacc >> bn) & 255
        putbyte(b)
        if b == 255:
            putbyte(0)
    bacc = bacc & ((1 << bn) - 1)

def align(padbit):
    if bn & 7:
        if padbit:
            putbits(255, 8 - (bn & 7))
        else:
            putbits(0, 8 - (bn & 7))

def category(v):
    return bitlen(v)

def encodeblock(coef, base, si, i):
    """one block as a standard encoder writes it; the scan's tables for its
    component number i"""
    dct = SDC[4 * si + i]
    act = SAC[4 * si + i]
    v = cget(coef, base)
    diff = v - PRED[i]
    PRED[i] = v
    t = category(diff)
    if H[dct + 256 + t] == 0:
        error()
    putbits(H[dct + t], H[dct + 256 + t])
    if t:
        if slt(diff, 0):
            putbits(diff - 1, t)
        else:
            putbits(diff, t)
    last = 0
    for k in range(1, 64):
        v = cget(coef, base + k)
        if v:
            r = k - last - 1
            last = k
            while r > 15:
                if H[act + 256 + 240] == 0:
                    error()
                putbits(H[act + 240], H[act + 256 + 240])
                r -= 16
            t = category(v)
            sym = (r << 4) | t
            if H[act + 256 + sym] == 0:
                error()
            putbits(H[act + sym], H[act + 256 + sym])
            if slt(v, 0):
                putbits(v - 1, t)
            else:
                putbits(v, t)
    if last < 63:
        if H[act + 256] == 0:
            error()
        putbits(H[act], H[act + 256])

# ---------------------------------------------------------------- progressive

BEBUF = array(1000)      # correction bits waiting for the next EOB run (BE)
MAX_BE = 937             # jcphuff.c: MAX_CORR_BITS - DCTSIZE2 + 1
ABSV = array(64)
BRBUF = array(64)
eobrun = 0
be = 0

def emit(t, sym):
    if H[t + 256 + sym] == 0:
        error()
    putbits(H[t + sym], H[t + 256 + sym])

def flushbe():
    global be
    for k in range(be):
        putbits(BEBUF[k], 1)
    be = 0

def flusheobrun(si):
    global eobrun
    if eobrun == 0:
        return
    nb = category(eobrun) - 1
    if nb > 14:
        error()
    emit(SAC[4 * si], nb << 4)
    if nb > 0:
        putbits(eobrun, nb)
    eobrun = 0
    flushbe()

def dcfirst(coef, base, si, i):
    v = sar(cget(coef, base), SAL[si])
    diff = v - PRED[i]
    PRED[i] = v
    t = category(diff)
    emit(SDC[4 * si + i], t)
    if t:
        if slt(diff, 0):
            putbits(diff - 1, t)
        else:
            putbits(diff, t)

def acfirst(coef, base, si):
    global eobrun
    act = SAC[4 * si]
    al = SAL[si]
    r = 0
    for k in range(SSS[si], SSE[si] + 1):
        v = cget(coef, base + k)
        neg = slt(v, 0)
        v = iabs(v) >> al
        if v == 0:
            r += 1
            continue
        flusheobrun(si)
        while r > 15:
            emit(act, 240)
            r -= 16
        t = category(v)
        emit(act, (r << 4) | t)
        if neg:
            putbits(-v - 1, t)
        else:
            putbits(v, t)
        r = 0
    if r > 0:
        eobrun += 1
        if eobrun == SMAXEOB[si]:
            flusheobrun(si)

def acrefine(coef, base, si):
    global eobrun, be
    act = SAC[4 * si]
    al = SAL[si]
    ss = SSS[si]
    se = SSE[si]
    eob = 0
    for k in range(ss, se + 1):
        ABSV[k] = iabs(cget(coef, base + k)) >> al
        if ABSV[k] == 1:
            eob = k
    r = 0
    br = 0
    for k in range(ss, se + 1):
        v = ABSV[k]
        if v == 0:
            r += 1
            continue
        while r > 15 and k <= eob:
            flusheobrun(si)
            emit(act, 240)
            r -= 16
            for ib in range(br):
                putbits(BRBUF[ib], 1)
            br = 0
        if v > 1:
            BRBUF[br] = v & 1
            br += 1
            continue
        flusheobrun(si)
        emit(act, (r << 4) | 1)
        if sgt(cget(coef, base + k), 0):
            putbits(1, 1)
        else:
            putbits(0, 1)
        for ib in range(br):
            putbits(BRBUF[ib], 1)
        br = 0
        r = 0
    if r > 0 or br > 0:
        eobrun += 1
        for ib in range(br):
            BEBUF[be] = BRBUF[ib]
            be += 1
        if eobrun == SMAXEOB[si] or be > MAX_BE:
            flusheobrun(si)

def unitblock(coef, base, si, i):
    """pjajpeg.EncodeUnitBlock"""
    if progressive == 0:
        encodeblock(coef, base, si, i)
    elif SSS[si] == 0:
        if SAH[si] == 0:
            dcfirst(coef, base, si, i)
        else:
            putbits(sar(cget(coef, base), SAL[si]) & 1, 1)
    elif SAH[si] == 0:
        acfirst(coef, base, si)
    else:
        acrefine(coef, base, si)

# ---------------------------------------------------------------- arithmetic coding
# pjajpeg's QM encoder (libjpeg's jcarith.c, bit for bit): its statistics
# are one byte per bin, the state in the low 7 bits, the MPS in bit 7

QDC = array(256)         # [4][64] bins of the DC tables
QAC = array(1024)        # [4][256] bins of the AC tables
QFIXED = array(1)        # the bin of probability 1/2
DCCTX = array(4)
LASTDC = array(4)
NONE = 4294967295        # "no byte buffered yet" (buffer = -1)
qc = 0
qa = 0
qct = 0
qbuf = 0
qsc = 0
qzc = 0

def qinit():
    global qc, qa, qct, qbuf, qsc, qzc
    qc = 0
    qa = 65536
    qct = 11
    qbuf = NONE
    qsc = 0
    qzc = 0

def qzeros():
    global qzc
    while qzc > 0:
        putbyte(0)
        qzc -= 1

def qcarry():
    """the buffered byte with a carry into it, the bytes held so far after it"""
    global qzc, qsc
    if qbuf != NONE:
        qzeros()
        putbyte(qbuf + 1)
        if qbuf + 1 == 255:
            putbyte(0)
    qzc = qzc + qsc
    qsc = 0

def qnocarry():
    global qzc, qsc
    if qbuf == 0:
        qzc += 1
    elif qbuf != NONE:
        qzeros()
        putbyte(qbuf)
    if qsc > 0:
        qzeros()
        while qsc > 0:
            putbyte(255)
            putbyte(0)
            qsc -= 1

def qencode(st, val):
    """val with the bin at H[st]"""
    global qc, qa, qct, qbuf, qsc
    sv = H[st]
    q = qetable[sv & 127]
    nl = q & 255
    nm = (q >> 8) & 255
    q = q >> 16
    qa = qa - q
    if val != (sv >> 7):
        if qa >= q:
            qc = qc + qa
            qa = q
        H[st] = (sv & 128) ^ nl
    else:
        if qa >= 32768:
            return
        if qa < q:
            qc = qc + qa
            qa = q
        H[st] = (sv & 128) ^ nm
    while True:
        qa = qa << 1
        qc = qc << 1
        qct -= 1
        if qct == 0:
            temp = qc >> 19
            if temp > 255:
                qcarry()
                qbuf = temp & 255
            elif temp == 255:
                qsc += 1
            else:
                qnocarry()
                qbuf = temp & 255
            qc = qc & 524287
            qct += 8
        if qa >= 32768:
            break

def qfinish():
    """jcarith.c finish_pass"""
    global qc
    temp = (qa - 1 + qc) & 4294901760
    if temp < qc:
        qc = temp + 32768
    else:
        qc = temp
    qc = qc << qct
    if qc & 4160749568:
        qcarry()
    else:
        qnocarry()
    if qc & 134215680:
        qzeros()
        putbyte((qc >> 19) & 255)
        if ((qc >> 19) & 255) == 255:
            putbyte(0)
        if qc & 522240:
            putbyte((qc >> 11) & 255)
            if ((qc >> 11) & 255) == 255:
                putbyte(0)

def qreset(si):
    """pjajpeg.ResetStats"""
    for i in range(SNC[si]):
        if progressive == 0 or (SSS[si] == 0 and SAH[si] == 0):
            t = STD[4 * si + i]
            for k in range(64):
                QDC[t * 64 + k] = 0
            LASTDC[i] = 0
            DCCTX[i] = 0
        if progressive == 0 or SSE[si] > 0:
            t = STA[4 * si + i]
            for k in range(256):
                QAC[t * 256 + k] = 0
    QFIXED[0] = 113

def arithdc(si, i, v):
    """pjajpeg.ArithEncodeDcDiff"""
    dc = base(QDC) + STD[4 * si + i] * 64
    x = DCCTX[i]
    if v == 0:
        qencode(dc + x, 0)
        DCCTX[i] = 0
        return
    qencode(dc + x, 1)
    if sgt(v, 0):
        qencode(dc + x + 1, 0)
        x = x + 2
        DCCTX[i] = 4
    else:
        v = -v
        qencode(dc + x + 1, 1)
        x = x + 3
        DCCTX[i] = 8
    m = 0
    v = v - 1
    if v != 0:
        qencode(dc + x, 1)
        m = 1
        v2 = v
        x = 20
        v2 = v2 >> 1
        while v2 != 0:
            qencode(dc + x, 1)
            m = m << 1
            x += 1
            v2 = v2 >> 1
    qencode(dc + x, 0)
    if m < ((1 << SDCL[4 * si + i]) >> 1):
        DCCTX[i] = 0
    elif m > ((1 << SDCU[4 * si + i]) >> 1):
        DCCTX[i] = DCCTX[i] + 8
    x = x + 14
    m = m >> 1
    while m != 0:
        if m & v:
            qencode(dc + x, 1)
        else:
            qencode(dc + x, 0)
        m = m >> 1

def arithacmag(ac, k, kx, x, v):
    """pjajpeg.ArithEncodeAcMag"""
    m = 0
    v = v - 1
    if v != 0:
        qencode(ac + x, 1)
        m = 1
        v2 = v >> 1
        if v2 != 0:
            qencode(ac + x, 1)
            m = m << 1
            if k <= kx:
                x = 189
            else:
                x = 217
            v2 = v2 >> 1
            while v2 != 0:
                qencode(ac + x, 1)
                m = m << 1
                x += 1
                v2 = v2 >> 1
    qencode(ac + x, 0)
    x = x + 14
    m = m >> 1
    while m != 0:
        if m & v:
            qencode(ac + x, 1)
        else:
            qencode(ac + x, 0)
        m = m >> 1

def sabs(v, al):
    """pjajpeg.ShiftedAbs, the sign aside"""
    return iabs(v) >> al

def arithblock(coef, base, si, i):
    """pjajpeg.ArithEncodeBlock"""
    fixed = base(QFIXED)
    if progressive == 0 or (SSS[si] == 0 and SAH[si] == 0):
        v = sar(cget(coef, base), SAL[si])
        arithdc(si, i, v - LASTDC[i])
        LASTDC[i] = v
        if progressive:
            return
    elif SSS[si] == 0:
        qencode(fixed, sar(cget(coef, base), SAL[si]) & 1)
        return
    if progressive:
        ss = SSS[si]
        se = SSE[si]
        al = SAL[si]
    else:
        ss = 1
        se = 63
        al = 0
    ac = base(QAC) + STA[4 * si + i] * 256
    ke = se
    while ke > 0 and sabs(cget(coef, base + ke), al) == 0:
        ke -= 1
    if progressive == 0 or SAH[si] == 0:
        k = ss
        while k <= ke:
            x = 3 * (k - 1)
            qencode(ac + x, 0)
            while True:
                cv = cget(coef, base + k)
                v = sabs(cv, al)
                if v != 0:
                    qencode(ac + x + 1, 1)
                    if slt(cv, 0):
                        qencode(fixed, 1)
                    else:
                        qencode(fixed, 0)
                    break
                qencode(ac + x + 1, 0)
                x = x + 3
                k += 1
            arithacmag(ac, k, SACK[4 * si + i], x + 2, v)
            k += 1
    else:
        kex = ke
        while kex > 0 and sabs(cget(coef, base + kex), SAH[si]) == 0:
            kex -= 1
        k = ss
        while k <= ke:
            x = 3 * (k - 1)
            if k > kex:
                qencode(ac + x, 0)
            while True:
                cv = cget(coef, base + k)
                v = sabs(cv, al)
                if v != 0:
                    if (v >> 1) != 0:
                        qencode(ac + x + 2, v & 1)
                    else:
                        qencode(ac + x + 1, 1)
                        if slt(cv, 0):
                            qencode(fixed, 1)
                        else:
                            qencode(fixed, 0)
                    break
                qencode(ac + x + 1, 0)
                x = x + 3
                k += 1
            k += 1
    if k <= se:
        qencode(ac + 3 * (k - 1), 1)     # EOB

def encodescanarith(si):
    """pjajpeg.EncodeScanArith: no padding, each restart interval flushed"""
    n = SNC[si]
    if n == 1:
        c = SCOMP[4 * si]
        w = CBWR[c]
        total = w * CBHR[c]
    else:
        w = mcusx
        total = mcusx * mcusy
    ri = SRI[si]
    rst = 0
    ux = 0
    uy = 0
    qinit()
    qreset(si)
    for u in range(total):
        if ri > 0 and u > 0 and u % ri == 0:
            qfinish()
            putbyte(255)
            putbyte(208 + (rst & 7))
            rst += 1
            qinit()
            qreset(si)
        if n == 1:
            c = SCOMP[4 * si]
            arithblock(CCOEF[c], (uy * CBW[c] + ux) * 64, si, 0)
        else:
            for i in range(n):
                c = SCOMP[4 * si + i]
                for y in range(CV[c]):
                    for x in range(CH[c]):
                        arithblock(CCOEF[c], ((uy * CV[c] + y) * CBW[c] + ux * CH[c] + x) * 64, si, i)
        ux += 1
        if ux == w:
            ux = 0
            uy += 1
    qfinish()

def encodescan(si):
    global bacc, bn, eobrun, be
    bacc = 0
    bn = 0
    eobrun = 0
    be = 0
    for i in range(4):
        PRED[i] = 0
    n = SNC[si]
    if n == 1:
        c = SCOMP[4 * si]
        w = CBWR[c]
        total = w * CBHR[c]
    else:
        w = mcusx
        total = mcusx * mcusy
    ri = SRI[si]
    rst = 0
    ux = 0
    uy = 0
    for u in range(total):
        if ri > 0 and u > 0 and u % ri == 0:
            flusheobrun(si)
            align(SPAD[si])
            putbyte(255)
            putbyte(208 + (rst & 7))
            rst += 1
            for i in range(4):
                PRED[i] = 0
        if n == 1:
            c = SCOMP[4 * si]
            unitblock(CCOEF[c], (uy * CBW[c] + ux) * 64, si, 0)
        else:
            for i in range(n):
                c = SCOMP[4 * si + i]
                for y in range(CV[c]):
                    for x in range(CH[c]):
                        unitblock(CCOEF[c], ((uy * CV[c] + y) * CBW[c] + ux * CH[c] + x) * 64, si, i)
        ux += 1
        if ux == w:
            ux = 0
            uy += 1
    flusheobrun(si)
    align(SPAD[si])

def recompose():
    p = 0
    for si in range(nscans):
        while p < SCUT[si]:
            putbyte(H[rawbase + p])
            p += 1
        if PJAX:
            # Huffman only: pjax leaves the arithmetic coder out
            if arithmetic:
                error()
            encodescan(si)
        else:
            if arithmetic:
                encodescanarith(si)
            else:
                encodescan(si)
    while p < rawlen:
        putbyte(H[rawbase + p])
        p += 1

def main():
    global origsize, hp
    if PJAX:
        pjaxmain()
    else:
        hp = base(HEAP)
        probeh()
        tables()
        modeltables()
        origsize = M[0] | (M[1] << 8) | (M[2] << 16) | (M[3] << 24)
        if M[SEG] != 5 or M[SEG + 1] != 0:
            error()
        hlen = M[SEG + 2] | (M[SEG + 3] << 8) | (M[SEG + 4] << 16) | (M[SEG + 5] << 24)
        dinit(SEG + 6, SEG + 6 + hlen)
        coderaw(origsize)
        parseheaders()
        scanbits()
        decodebands(SEG + 6 + hlen, inlen())
        recompose()
        if outn != origsize:
            error()
        # the next segment of the block, if any, starts from scratch
        reset(hp)
