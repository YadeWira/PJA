# GitHub's language detection: .inc is ambiguous (it took the generated
# ZPAQL decoder for SourcePawn). Ours are Pascal includes.
*.inc linguist-language=Pascal
# the plugin's ZPAQL decoder, generated by tools/zpaql/gen_pjadec.py
pas/plugin/pjazpaql.inc linguist-generated=true
pas/plugin/zpaql/consts.zl linguist-generated=true
# the decoder's sources: the subset of Python zpaqlc compiles
*.zl linguist-language=Python
